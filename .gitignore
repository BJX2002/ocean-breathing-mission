# Source masters and authoring archives are retained locally. The web-ready
# H.264/AAC *.web.mp4 files remain tracked for the playable demo.
public/assets/chapter1/op/*.mp4
!public/assets/chapter1/op/*.web.mp4
public/assets/chapter1/op2/*.hevc*.mp4

# Keep local source masters and superseded asset sets out of the web release.
# The final H.264/AAC delivery copies remain tracked.
public/assets/chapter1/archive/
public/assets/chapter1/OP_NEW/*.mp4
!public/assets/chapter1/OP_NEW/*.web.mp4
!public/assets/chapter1/OP_NEW/*.tablet.mp4
